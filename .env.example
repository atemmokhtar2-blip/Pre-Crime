# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=

# Super-admin panel owners: comma-separated Telegram user IDs with full,
# irrevocable access to the in-bot admin panel (/admin). Additional admins
# with granular permissions are managed from inside the panel itself.
BOT_OWNER_IDS=

# PostgreSQL (provision Neon through the Vercel Marketplace)
DATABASE_URL=

# Dashboard authentication (generate a long random value; never commit it)
AUTH_SECRET=
APP_URL=http://localhost:3000

# Optional, only when Redis is provisioned
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
